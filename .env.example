# CHA Heritage Trail — environment configuration (EXAMPLE)
#
# Copy to `.env` and fill in REAL values. NEVER commit the real .env.
# Preferred location: ABOVE the web root (one level up from the WordPress
# install), so it is never web-served. Point the loader at it with a
# wp-config.php constant if it lives elsewhere:
#
#     define( 'CHA_ENV_PATH', '/home/<cpanel-user>/.env' );
#
# Fallback: instead of a .env file you may define any of these as constants in
# wp-config.php (e.g. define( 'PAYSTACK_SECRET_KEY', '...' );). .env wins if
# both are present. Secrets live ONLY here or in wp-config — never in the
# database, never in the app bundle.
#
# Start with Paystack TEST keys. Switch to sk_live_... only after an
# end-to-end sandbox run (checkout → verify-token → token email) has passed.

# ── Paystack ─────────────────────────────────────────────────────────────
# Secret key from the Paystack dashboard (Settings → API Keys & Webhooks).
# No webhook is used: /verify-token calls the Verify Transaction API directly
# and synchronously, authenticated with this same secret key.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Subaccount code for the CHA split (percentage_charge: 20 — 80% CHA, 20%
# Acutus). Created once, manually, in the Paystack dashboard (see brief §8).
PAYSTACK_SUBACCOUNT_CODE=ACCT_xxxxxxxxxxxxxx
# Where Paystack returns the buyer after paying (the app's own origin — the
# unlock happens there, not on the WordPress site).
CHECKOUT_REDIRECT_URL=https://trail.clarensheritage.org

# ── App origin / CORS ───────────────────────────────────────────────────────
# The PWA is served from its own host (Cloudflare Workers Static Assets) while
# this REST API stays on the WordPress domain, so cha/v1 must name the app's
# origin in its Access-Control-Allow-Origin header. Optional — omit and the
# plugin defaults to https://trail.clarensheritage.org (CHA_Cors::DEFAULT_APP_ORIGIN).
# Comma-separate to allow extra origins (e.g. a preview build); the FIRST
# entry is the one advertised on the public content feed.
#CHA_APP_ORIGIN=https://trail.clarensheritage.org

# ── Transactional email (Brevo via SMTP) ────────────────────────────────────
# The token email is the purchase recovery path, so deliverability matters.
# Recommended: WP Mail SMTP plugin pointed at Brevo. These slots are also read
# directly by the plugin if you wire SMTP without the plugin. SPF/DKIM/DMARC on
# the domain are configured separately (owner-managed).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@clarensheritage.org
SMTP_FROM_NAME=Clarens Heritage Association
